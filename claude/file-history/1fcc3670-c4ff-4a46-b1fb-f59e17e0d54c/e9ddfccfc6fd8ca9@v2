<app-editable-grid
  [dataSource]="data"
  [columns]="columns"
  keyExpr="fnfAlumniId"
  [gridTitle]="'Alumni Register'"
  [gridIcon]="'fa-solid fa-user-clock'"
  [gridSubtitle]="gridSubtitle"
  [showRefreshButton]="true"
  [refreshDisabled]="isLoading"
  [allowAdding]="true"
  [allowDeleting]="true"
  addButtonText="Add Record"
  [newRowDefaults]="newRowDefaults"
  [isCellEditable]="isCellEditable"
  [onEditorPreparing]="onEditorPreparing"
  [insertFn]="addRecord"
  [updateFn]="updateRecord"
  [deleteFn]="deleteRecord"
  (refresh)="load()"
></app-editable-grid>
