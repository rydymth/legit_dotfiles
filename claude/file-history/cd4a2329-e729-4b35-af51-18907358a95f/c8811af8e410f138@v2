import { Component, inject, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import { RouterLink } from '@angular/router';
import { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';
import { AccountService } from '../../core/services/account.service';
import { ToastService } from '../../core/services/toast.service';
import { SignupRequest } from '../../core/models/account.model';
import { indianMobileValidator } from '../../core/validators/indian-mobile.validator';

@Component({
  selector: 'app-signup',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule, RouterLink],
  templateUrl: './signup.html',
  styleUrl: './signup.scss'
})
export class Signup {
  private readonly fb = inject(FormBuilder);
  private readonly accountService = inject(AccountService);
  private readonly toast = inject(ToastService);

  readonly isSubmitting = signal(false);
  readonly submitError = signal<string | null>(null);
  readonly submitResult = signal<{ companyName: string; adminEmail: string } | null>(null);

  readonly form = this.fb.group({
    companyName: ['', [Validators.required, Validators.minLength(2), Validators.maxLength(200)]],
    adminName: ['', [Validators.required, Validators.minLength(2), Validators.maxLength(150)]],
    adminEmail: ['', [Validators.required, Validators.email, Validators.maxLength(256)]],
    // Contact Number is optional for now - uncomment Validators.required to make it mandatory
    // again (format is still checked whenever something is actually entered).
    contactNumber: ['', [
      // Validators.required,
      indianMobileValidator
    ]]
  });

  get f() {
    return this.form.controls;
  }

  isInvalid(controlName: string): boolean {
    const control = this.form.get(controlName);
    return !!control && control.invalid && (control.dirty || control.touched);
  }

  submit(): void {
    this.submitError.set(null);

    if (this.form.invalid) {
      this.form.markAllAsTouched();
      return;
    }

    const value = this.form.getRawValue();
    const request: SignupRequest = {
      companyName: value.companyName!.trim(),
      adminName: value.adminName!.trim(),
      adminEmail: value.adminEmail!.trim(),
      contactNumber: value.contactNumber!.trim()
    };

    this.isSubmitting.set(true);

    this.accountService.signup(request).subscribe({
      next: response => {
        this.isSubmitting.set(false);
        if (!response.isSuccess) {
          this.submitError.set(response.message);
          this.toast.error(response.message);
          return;
        }
        this.submitResult.set({
          companyName: response.data!.companyName,
          adminEmail: response.data!.adminEmail
        });
        this.toast.success('Account created! Check your email for your login details.');
      },
      error: err => {
        this.isSubmitting.set(false);
        const message = err?.error?.message || 'Something went wrong while registering your company. Please try again.';
        this.submitError.set(message);
        this.toast.error(message);
      }
    });
  }
}
