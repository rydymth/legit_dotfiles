using SubscriptionPortal.DataAccessLayer.Repositories.EmailLogs.Implementation;
using SubscriptionPortal.DataAccessLayer.Repositories.EmailLogs.Interface;
using SubscriptionPortal.DataAccessLayer.Repositories.Payments.Implementation;
using SubscriptionPortal.DataAccessLayer.Repositories.Payments.Interface;
using SubscriptionPortal.DataAccessLayer.Repositories.RoleRights.Implementation;
using SubscriptionPortal.DataAccessLayer.Repositories.RoleRights.Interface;
using SubscriptionPortal.DataAccessLayer.Repositories.Roles.Implementation;
using SubscriptionPortal.DataAccessLayer.Repositories.Roles.Interface;
