#!/bin/sh
# ===============================================
#  Aurora Midnight River Init
#  Author: Rudy + GPT (Zig Ecosystem Port)
# ===============================================

# --- Environment setup ---
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=river
riverctl spawn "systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK I3SOCK XCURSOR_SIZE XCURSOR_THEME"
riverctl spawn "systemctl --user start xdg-desktop-portal-wlr.service"

# --- Launch background & bar ---
swaybg -i $(cat ~/.cache/cache_wall/current_wal) -m fill &
riverctl spawn "~/.config/scripts/restart_waybar.sh &"
swaync &
riverctl spawn "nm-applet --indicator"
riverctl spawn "blueman-applet"

# --- Idle management ---
swayidle -w \
  timeout 450 'swaylock -f -c 000000' \
  timeout 900 'riverctl send-input-event power off' \
  resume 'riverctl send-input-event power on' \
  before-sleep 'swaylock -f -c 000000' &

# --- Layout (rivertile) ---
rivertile -view-padding 7 -outer-padding 5 &
riverctl default-layout rivertile

# --- Aurora Midnight Colors ---
# bg="0x0E1116"
# bg_alt="0x1F242D"
# teal="0x00A99D"
# purple="0x8C6CD1"
# red="0xD96B6B"
# gray="0x707885"

riverctl border-color-focused 0x00A99D
riverctl border-color-unfocused 0x1F242D
riverctl border-width 2

# --- Keyboard repeat rate ---
riverctl set-repeat 40 250

# --- Rules ---
riverctl rule-add -app-id "float*" float
riverctl rule-add -app-id "mpv" float
riverctl rule-add -app-id "pavucontrol" float
riverctl rule-add -app-id "file-roller" float
riverctl rule-add -title "Picture-in-Picture" float

# --- Gaps ---
rivertile -view-padding 7 -outer-padding 7 &

# --- Keybindings ---
mod="Super"
term="ghostty"
menu="wofi -c ~/.config/wofi/spotlight_search --allow-images --allow-markups"

# Terminal / Apps
riverctl map normal $mod Return spawn "$term"
riverctl map normal $mod Space spawn "$menu"
riverctl map normal $mod B spawn "bash ~/.config/scripts/wallpaper_thumbnail_generator.sh"
riverctl map normal $mod+Control P spawn "grim"
riverctl map normal Super Q close

# Exit + reload
riverctl map normal $mod+Shift C spawn "pkill rivertile && exec riverctl default-layout rivertile"
riverctl map normal $mod+Shift E spawn "wlogout"

# Focus movement (Vim style)
riverctl map normal $mod H focus-view left
riverctl map normal $mod J focus-view down
riverctl map normal $mod K focus-view up
riverctl map normal $mod L focus-view right

riverctl map normal Control+Shift H snap left
riverctl map normal Control+Shift J snap down
riverctl map normal Control+Shift K snap up
riverctl map normal Control+Shift L snap right

riverctl map normal Super+Shift J swap next
riverctl map normal Super+Shift K swap previous

# Move windows
riverctl map normal Alt+Shift H move left 100
riverctl map normal Alt+Shift J move down 100
riverctl map normal Alt+Shift K move up 100
riverctl map normal Alt+Shift L move right 100

# Floating & fullscreen
riverctl map normal $mod+Shift Space toggle-float
riverctl map normal $mod F toggle-fullscreen

# Multi-Monitor
riverctl map normal Super Period focus-output next
riverctl map normal Super Comma focus-output previous

# Super+Shift+{Period,Comma} to send the focused view to the next/previous output
riverctl map normal Super+Shift Period send-to-output next
riverctl map normal Super+Shift Comma send-to-output previous

riverctl map normal $mod w spawn '$HOME/.config/scripts/hidewaybar.sh'

# --- Workspaces / Tags (7 persistent) ---
for i in $(seq 1 7); do
  tags=$((1 << ($i - 1)))

  # Switch
  riverctl map normal $mod $i set-focused-tags $tags
  # Move container
  riverctl map normal $mod+Shift $i set-view-tags $tags
  # Toggle focus/view
  riverctl map normal $mod+Control $i toggle-focused-tags $tags
  riverctl map normal $mod+Shift+Control $i toggle-view-tags $tags
done

# Focus all tags
all_tags=$(((1 << 32) - 1))
riverctl map normal $mod 0 set-focused-tags $all_tags
riverctl map normal $mod+Shift B spawn "~/.config/scripts/restart_waybar.sh &"

# --- Volume / Brightness / Media ---
for mode in normal locked; do
  riverctl map $mode None XF86AudioRaiseVolume spawn '$HOME/.config/scripts/volume.sh up'
  riverctl map $mode None XF86AudioLowerVolume spawn '$HOME/.config/scripts/volume.sh down'
  riverctl map $mode None XF86AudioMute spawn 'pactl set-sink-mute @DEFAULT_SINK@ toggle'

  riverctl map $mode None XF86MonBrightnessUp spawn '$HOME/.config/scripts/brightness.sh up'
  riverctl map $mode None XF86MonBrightnessDown spawn '$HOME/.config/scripts/brightness.sh down'

  riverctl map $mode None XF86AudioNext spawn "playerctl next"
  riverctl map $mode None XF86AudioPrev spawn "playerctl previous"
  riverctl map $mode None XF86AudioPlay spawn "playerctl play-pause"
done

# --- Mouse ---
riverctl map-pointer normal $mod BTN_LEFT move-view
riverctl map-pointer normal $mod BTN_RIGHT resize-view
riverctl map-pointer normal $mod BTN_MIDDLE toggle-float

riverctl declare-mode passthrough

riverctl map normal Super F11 enter-mode passthrough

riverctl map passthrough Super F11 enter-mode normal

riverctl set-repeat 50 300
riverctl input pointer-1452-657-bcm5974 tap enabled
riverctl hide-cursor when-typing enabled

riverctl spawn "wlsunset -l 18 -L 73 &" # optional night light
riverctl rule-add ssd
# riverctl rule-add float
riverctl focus-follows-cursor normal

riverctl float-filter-add app-id float
riverctl float-filter-add app-id 'pavucontrol'
riverctl float-filter-add app-id 'Timeshift-gtk'
riverctl float-filter-add app-id 'pavucontrol'
riverctl float-filter-add app-id 'nm-connection-editor'
riverctl float-filter-add app-id 'nwg-look'
riverctl float-filter-add app-id 'valent'
riverctl float-filter-add app-id 'file-roller'
riverctl float-filter-add app-id 'GParted'
riverctl float-filter-add app-id 'ristretto'
riverctl float-filter-add title "popup title with spaces"
riverctl float-filter-add title "Open File"
riverctl float-filter-add title "File Operation Progress"
riverctl float-filter-add title "Preferences"
riverctl float-filter-add title "dialog"
riverctl float-filter-add title "Picture-in-Picture"
riverctl float-filter-add title "bubble"
riverctl float-filter-add title "task_dialog"
riverctl float-filter-add title "menu"
riverctl float-filter-add title "Confirm to replace files"
